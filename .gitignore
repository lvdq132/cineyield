# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
# NOT `/node_modules` -- a leading slash anchors to the repo root, so it never
# matched apps/web/node_modules, which is how 22,108 dependency files ended up
# committed. This form matches at any depth.
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
apps/web/test-results/
apps/web/playwright-report/

# next.js
apps/web/.next/
apps/web/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Python backend
apps/agent-api/.venv/
apps/agent-api/__pycache__/
apps/agent-api/**/__pycache__/
apps/agent-api/.pytest_cache/
apps/agent-api/.mypy_cache/
apps/agent-api/.ruff_cache/
apps/agent-api/*.egg-info/
apps/agent-api/.env

# env files (backend)
.env
.worktrees/

# The public marketing site is a separate Sites-managed Git repository.
/sites/
