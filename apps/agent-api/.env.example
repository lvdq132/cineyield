# CineYield Agent API — environment configuration
# Copy to .env and fill in real values. Never commit .env.

# Service
ENVIRONMENT=development
LOG_LEVEL=INFO

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Google Cloud (set for production / Cloud Run deployment)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

# Gemini
# Use GOOGLE_API_KEY for direct API access (development)
# Use GOOGLE_CLOUD_PROJECT + ADC for production / Agent Engine
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Google Cloud Storage
GCS_BUCKET_NAME=

# ─────────────────────────────────────────────────────────────
# ClickHouse — official mcp-clickhouse variable names
# See: https://github.com/ClickHouse/mcp-clickhouse
# ─────────────────────────────────────────────────────────────
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=
CLICKHOUSE_DATABASE=cineyield
CLICKHOUSE_SECURE=true
CLICKHOUSE_VERIFY=true
CLICKHOUSE_CONNECT_TIMEOUT=30
CLICKHOUSE_SEND_RECEIVE_TIMEOUT=30

# mcp-clickhouse authentication
# For local dev with stdio transport (no auth needed):
CLICKHOUSE_MCP_AUTH_DISABLED=true
# For HTTP/SSE transport, use a bearer token instead:
# CLICKHOUSE_MCP_AUTH_TOKEN=your-generated-token
